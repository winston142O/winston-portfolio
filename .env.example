# Contact form email delivery (https://resend.com)
# Without RESEND_API_KEY the form shows an error and visitors fall back to direct email.
RESEND_API_KEY=
# Sender shown on contact emails. Use a verified domain sender in production;
# onboarding@resend.dev works for testing.
RESEND_FROM="Portfolio <onboarding@resend.dev>"
# Where contact form messages are delivered. Defaults to the profile email.
CONTACT_TO_EMAIL=winston1420@hotmail.com

# Canonical site URL, used for SEO metadata and the sitemap
NEXT_PUBLIC_SITE_URL=https://example.com
